# =============================================================================
# StudyOS Environment Variables Configuration
# =============================================================================
# IMPORTANT: Never commit .env.local or production secrets to source control.
# Copy this file to .env.local and fill in your Supabase credentials.

# -----------------------------------------------------------------------------
# 1. Supabase Public Keys (Client & Server Accessible)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# -----------------------------------------------------------------------------
# 2. Application Base URL
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# 3. Server-Only Secrets (NEVER expose to NEXT_PUBLIC_*)
# -----------------------------------------------------------------------------
# SUPABASE_SERVICE_ROLE_KEY is strictly for server-side administrative tasks.
# It bypasses Row Level Security. Never import or use this on the client.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# -----------------------------------------------------------------------------
# 4. AI Provider Secrets (Phase 4 - Server-Only)
# -----------------------------------------------------------------------------
# GEMINI_API_KEY=your-gemini-api-key-here
# OPENAI_API_KEY=your-openai-api-key-here
